{
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/dist",
  "installCommand": "cd website && npm install",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(llms|llms-full|robots).txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|llms\\.txt|llms-full\\.txt|google.*\\.html|favicon\\..*|logo\\.png|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
